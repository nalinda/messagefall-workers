{
  "name": "messagefall-workers",
  "version": "0.1.0",
  "description": "Outbound messaging for Cloudflare Workers: WhatsApp first with SMS fallback, email, typed templates, delivery-status webhooks, and a client for Worker-to-Worker sends",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nalinda/messagefall-workers.git"
  },
  "homepage": "https://github.com/nalinda/messagefall-workers#readme",
  "bugs": {
    "url": "https://github.com/nalinda/messagefall-workers/issues"
  },
  "packageManager": "bun@1.4.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./durable": {
      "types": "./dist/durable/index.d.ts",
      "import": "./dist/durable/index.js",
      "default": "./dist/durable/index.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*/index.d.ts",
      "import": "./dist/providers/*/index.js",
      "default": "./dist/providers/*/index.js"
    }
  },
  "files": [
    "dist",
    "*.md",
    "LICENSE",
    ".gitignore"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --cache --cache-location .eslintcache --cache-strategy content",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts-check": "tsc --noEmit",
    "test": "bun test",
    "test:exports": "bun test test/exports.test.ts",
    "prepare": "husky"
  },
  "eslintConfig": {
    "extends": [
      "@serendibyte-co/eslint-config"
    ]
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4.0.0",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "prettier": "@serendibyte-co/prettier-config",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@serendibyte-co/eslint-config": "git+https://github.com/serendibyte-co/eslint-config.git#v1.4.1",
    "@serendibyte-co/prettier-config": "git+https://github.com/serendibyte-co/prettier-config.git#v1.0.2",
    "@types/bun": "^1.4.0",
    "eslint": "^10.8.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.3",
    "hono": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "miniflare": "5.20260918.0-alpha",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "wrangler": "^4.0.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
