"range":"1092","text":"951"},{"varName":"1093"},{"range":"1094","text":"975"},"Remove unused variable \"CreateMessagingMagicLinkOptions\".",{"range":"1095","text":"975"},{"varName":"1096"},{"range":"1097","text":"975"},{"range":"1098","text":"975"},"suggestion-apply-replacement",{"range":"1099","text":"1100"},{},"Switch to `.toSorted()`.","directive","fixed repo path",{"range":"1101","text":"1102"},[1074,1077],"unknown",[1074,1077],"never",[1303,3155],"  private readonly state: any;\n\n  readonly id = 'stub';\n\n  readonly channel = 'whatsapp' as const;\n\n  constructor(state: any) {\n    this.state = state;\n  }\n\n  async send(options: {\n    config: Record<string, unknown>;\n    channel: Channel;\n    template: any;\n    input: unknown;\n    policy?: any;\n  }): Promise<{\n    messageId: string;\n    status: Promise<any>;\n  }> {\n    const { template, input } = options;\n    const messageId = `stub-${Date.now()}`;\n\n    if (!this.state.queue.has(messageId)) {\n      this.state.queue.set(messageId, []);\n    }\n    this.state.queue.get(messageId)!.push({\n      id: messageId,\n      kind: template.kind,\n      channel: options.channel,\n      status: 'pending' as const,\n      statusTimestamp: new Date(),\n      templateId: template.id,\n    });\n\n    setTimeout(() => {\n      this.state.queue.get(messageId)!.forEach((msg: any) => {\n        if (msg.id === messageId) {\n          msg.status = 'sent' as const;\n          msg.statusTimestamp = new Date();\n        }\n      });\n      this.storeStatus(messageId, 'sent', new Date());\n    }, 100);\n\n    return {\n      messageId,\n      status: Promise.resolve({\n        status: 'sent' as const,\n        timestamp: new Date(),\n        details: {\n          provider: this.id,\n          fake: true,\n        },\n      }),\n    };\n  }\n\n  status(messageId: string): Promise<any> {\n    return {\n      status: 'sent' as const,\n      timestamp: new Date(),\n      details: {\n        provider: this.id,\n        fake: true,\n      },\n    };\n  }\n\n  statusHandler?(request: Request): Response {\n    console.log('[Stub] Webhook received');\n    return new Response('OK', { status: 200 });\n  }\n\n  storeStatus(id: string, status: any, timestamp: Date): void {\n    const entries = this.state.store.get(id) ?? [];\n    entries.push({ id, status, timestamp });\n    this.state.store.set(id, entries);\n  }","private field `state`","public field `channel`",[1395,1398],[1395,1398],[1422,1425],[1422,1425],[1460,1667],"send(options: {\n    config: Record<string, unknown>;\n    channel: Channel;\n    template: any;\n    input: unknown;\n    policy?: any;\n  }): {\n    messageId: string;\n    status: Promise<any>;\n  }",[1555,1558],[1555,1558],[1593,1596],[1593,1596],[1657,1660],[1657,1660],[2158,2161],[2158,2161],[2643,2646],[2643,2646],[2986,2989],[2986,2989],[197,215],"",[366,2412],"  private readonly state: any;\n\n  readonly id = 'stub';\n\n  readonly channel = 'whatsapp' as const;\n\n  constructor(state: { kv: any; durable?: { class: any; id: string | number } }) {\n    this.state = state;\n  }\n\n  async send(options: {\n    config: Record<string, unknown>;\n    channel: Channel;\n    template: { kind: 'otp' | 'text' };\n    input: unknown;\n    policy?: any;\n  }): Promise<{\n    messageId: string;\n    status: Promise<MessageStatus>;\n  }> {\n    const { template, input } = options;\n    const messageId = `stub-${Date.now()}`;\n\n    if (!this.state.queue.has(messageId)) {\n      this.state.queue.set(messageId, []);\n    }\n    this.state.queue.get(messageId)!.push({\n      id: messageId,\n      kind: template.kind,\n      channel: options.channel,\n      status: 'pending' as const,\n      statusTimestamp: new Date(),\n      templateId: template.id,\n    });\n\n    setTimeout(() => {\n      this.state.queue.get(messageId)!.forEach((msg: any) => {\n        if (msg.id === messageId) {\n          msg.status = 'sent' as const;\n          msg.statusTimestamp = new Date();\n        }\n      });\n      this.storeStatus(messageId, 'sent', new Date());\n    }, 100);\n\n    return Promise.resolve({\n      messageId,\n      status: Promise.resolve({\n        status: 'sent' as const,\n        timestamp: new Date(),\n        details: {\n          provider: this.id,\n          fake: true,\n        },\n      }),\n    });\n  }\n\n  status(messageId: string): Promise<MessageStatus> {\n    this.storeStatus(messageId, 'sent', new Date());\n    return Promise.resolve({\n      status: 'sent' as const,\n      timestamp: new Date(),\n      details: {\n        provider: this.id,\n        fake: true,\n      },\n    });\n  }\n\n  statusHandler?(request: Request): Response {\n    console.log('[Stub] Webhook received');\n    return new Response('OK', { status: 200 });\n  }\n\n  storeStatus(id: string, status: DeliveryStatus, timestamp: Date): void {\n    const entries = this.state.store.get(id) ?? [];\n    entries.push({ id, status, timestamp });\n    this.state.store.set(id, entries);\n  }",[458,461],[458,461],[491,494],[491,494],[515,518],[515,518],[732,735],[732,735],[1307,1310],[1307,1310],[2538,2541],[2538,2541],[2705,2708],[2705,2708],"DurableObject",[50,114],[48,113],"MessageState",[152,166],[152,166],[1694,1740],"get(key: string): string | null",[1781,1833],"put(key: string, value: string): void",[1874,1914],"delete(key: string): void",[2124,2124],"void ",[2124,2124],"await ",[2211,2211],[2211,2211],[3288,3291],[3288,3291],[3347,3353],[3367,3370],[3367,3370],[3607,3613],[3770,3776],[4031,4034],[4031,4034],[4330,4481],"send(options: { template: TemplateDefinition; input: unknown; channel: Channel }): { messageId: string; status: Promise<MessageStatus> }",[4758,4761],[4758,4761],[4980,5131],[5279,5334],"status(messageId: string): MessageStatus",[5398,5454],"statusHandler(request: Request): Response",[5655,5658],[5655,5658],[5879,6030],[6298,6301],[6298,6301],[6496,6647],[6909,6912],[6909,6912],[7125,7276],[7553,7556],[7553,7556],[2024,2027],[2024,2027],[2203,2206],